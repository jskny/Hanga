<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net5.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <PuppeteerVersion Condition="'$(PuppeteerVersion)' == ''">25.12.0</PuppeteerVersion>
    <PuppeteerMajor>$([System.Version]::Parse($(PuppeteerVersion)).Major)</PuppeteerMajor>
    <DefineConstants Condition="$(PuppeteerMajor) &gt;= 18">$(DefineConstants);PPTR_IFACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PuppeteerSharp" Version="$(PuppeteerVersion)" />
    <PackageReference Include="RazorLight" Version="2.3.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="templates/**;wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Vs2019Compiler)' == 'true'">
    <RoslynCompilerType>Custom</RoslynCompilerType>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>
  <ItemGroup Condition="'$(Vs2019Compiler)' == 'true'">
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
