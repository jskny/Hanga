@model InvoiceModel
@{
    ViewData["Title"] = "請求書";
}

<h1>請 求 書</h1>
<section class="to">
    <p class="customer"><span id="customer-name">(読み込み中)</span> 御中</p>
    <p>ご担当: <span id="customer-person">(読み込み中)</span> 様</p>
    <p>住所: <span id="customer-address">(読み込み中)</span></p>
</section>
<p>請求番号: @Model.InvoiceNo</p>
<table class="lines">
    <thead><tr><th>品名</th><th>数量</th><th>単価</th><th>金額</th></tr></thead>
    <tbody>
        @foreach (var line in Model.Lines)
        {
            <tr><td>@line.Name</td><td class="num">@line.Quantity</td><td class="num money">@line.UnitPrice</td><td class="num money amount">@line.Amount</td></tr>
        }
    </tbody>
</table>
<p class="total">合計: <span id="total"></span></p>

@section Scripts {
    <script>
        // 表示時に、ログインが必要なAPIから宛先を取得する
        fetch('/api/customers/@Model.CustomerId', { credentials: 'same-origin' })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (c) {
                document.getElementById('customer-name').textContent = c.name;
                document.getElementById('customer-person').textContent = c.person;
                document.getElementById('customer-address').textContent = c.address;
            });
    </script>
}
